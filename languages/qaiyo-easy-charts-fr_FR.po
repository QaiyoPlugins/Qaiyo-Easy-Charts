#: src/Admin/SettingsPage.php:94
msgid "You do not have permission to access this page."
msgstr "Vous n’avez pas l’autorisation d’accéder à cette page."

#: src/Admin/SettingsPage.php:114
msgid "ID of a saved chart. Any other attribute overrides its settings."
msgstr "ID d’un graphique enregistré. Tout autre attribut remplace ses réglages."

#: src/Admin/SettingsPage.php:115
msgid "Inline bars: rows separated by \"|\", fields by \";\" — label;value;range end;value text."
msgstr "Barres en ligne : lignes séparées par \"|\", champs par \";\" — libellé;valeur;fin de plage;texte de valeur."

#: src/Admin/SettingsPage.php:117
msgid "Title (accessible name; shown with show_title=\"yes\")."
msgstr "Titre (nom accessible ; affiché avec show_title=\"yes\")."

#: src/Admin/SettingsPage.php:118
msgid "Unit, e.g. days."
msgstr "Unité, par ex. jours."

#: src/Admin/SettingsPage.php:119
msgid "Axis range and step. Empty max: automatic."
msgstr "Plage et pas de l’axe. max vide : automatique."

#: src/Admin/SettingsPage.php:120
msgid "Colors, e.g. #0f0c24."
msgstr "Couleurs, par ex. #0f0c24."

#: src/Admin/SettingsPage.php:121
msgid "Font family, e.g. \"DM Sans, sans-serif\"."
msgstr "Police, par ex. \"DM Sans, sans-serif\"."

#: src/Admin/SettingsPage.php:122
msgid "Bar thickness, column chart height, corner radius, e.g. 28px."
msgstr "Épaisseur des barres, hauteur du graphique en colonnes, arrondi des coins, par ex. 28px."

#: src/Admin/SettingsPage.php:125
msgid "Animation length and delay between bars in milliseconds, e.g. 1100 and 140."
msgstr "Durée de l’animation et délai entre les barres en millisecondes, p. ex. 1100 et 140."

#: src/Ai/Abilities.php:44
msgid "Qaiyo Easy Charts"
msgstr "Qaiyo Easy Charts"

#: src/Ai/Abilities.php:45
msgid "Create and read charts (bars with ranges, comparison bars, KPI rings, timelines, bullet charts, 100% stacked bars, rating distributions) that can be embedded with a shortcode."
msgstr "Créer et lire des graphiques (barres avec plages, barres comparatives, anneaux KPI, chronologies, graphiques à puces, barres empilées à 100 %, distributions de notes) intégrables par shortcode."

#: src/Ai/Abilities.php:64
msgid "Label of the row."
msgstr "Libellé de la ligne."

#: src/Ai/Abilities.php:68
msgid "The value. Timeline: the start. Rating: the number of ratings."
msgstr "La valeur. Chronologie : le début. Note : le nombre d’avis."

#: src/Ai/Abilities.php:72
msgid "Optional second value. Bars: end of a highlighted range (15 for \"10–15\"). Comparison: the second series. Ring: the goal. Timeline: the finish. Bullet: the target."
msgstr "Deuxième valeur facultative. Barres : fin d’une plage mise en avant (15 pour « 10–15 »). Comparaison : la deuxième série. Anneau : l’objectif. Chronologie : la fin. Puce : la cible."

#: src/Ai/Abilities.php:76
msgid "Optional text shown instead of the number, e.g. \"up to 5\"."
msgstr "Texte facultatif affiché à la place du nombre, par ex. \"jusqu’à 5\"."

#: src/Ai/Abilities.php:94
msgid "List charts"
msgstr "Lister les graphiques"

#: src/Ai/Abilities.php:95
msgid "Lists the saved charts with their ID, title, status and the shortcode that embeds each one."
msgstr "Liste les graphiques enregistrés avec leur ID, titre, statut et le code court qui les intègre."

#: src/Ai/Abilities.php:117
msgid "Get chart"
msgstr "Obtenir un graphique"

#: src/Ai/Abilities.php:118
msgid "Returns one saved chart: its type, rows (label, value, optional second value and text), unit, orientation and shortcode."
msgstr "Renvoie un graphique enregistré : son type, ses lignes (libellé, valeur, deuxième valeur et texte facultatifs), son unité, son orientation et son shortcode."

#: src/Ai/Abilities.php:126
msgid "Chart ID."
msgstr "ID du graphique."

#: src/Ai/Abilities.php:140
msgid "How many times the chart was seen (anonymous, counted when it scrolls into view)."
msgstr "Nombre de fois où le graphique a été vu (anonyme, compté lorsqu’il apparaît à l’écran)."

#: src/Ai/Abilities.php:166
msgid "Create chart"
msgstr "Créer un graphique"

#: src/Ai/Abilities.php:167
msgid "Creates a saved chart and returns its ID and the shortcode to place it in content. Each row has a label, a value and an optional second value whose meaning depends on the chart type."
msgstr "Crée un graphique enregistré et renvoie son ID et le shortcode pour l’insérer. Chaque ligne a un libellé, une valeur et une deuxième valeur facultative dont le sens dépend du type de graphique."

#: src/Ai/Abilities.php:175
msgid "Chart title; also its accessible name."
msgstr "Titre du graphique ; c’est aussi son nom accessible."

#: src/Ai/Abilities.php:189
msgid "bars: bars with optional ranges; compare: two series per row; ring: KPI rings; timeline: start–finish bars; bullet: value against a target; stacked: one 100% bar split into parts; rating: rating levels with counts."
msgstr "bars : barres avec plages facultatives ; compare : deux séries par ligne ; ring : anneaux KPI ; timeline : barres début–fin ; bullet : valeur face à une cible ; stacked : une barre à 100 % découpée en parts ; rating : niveaux de note avec effectifs."

#: src/Ai/Abilities.php:198
msgid "Unit shown on the axis, e.g. \"days\"."
msgstr "Unité affichée sur l’axe, par ex. \"jours\"."

#: src/Ai/Abilities.php:204
msgid "Colour scheme: light, dark, or auto (follows the visitor and the theme)."
msgstr "Jeu de couleurs : clair, sombre ou automatique (suit le visiteur et le thème)."

#: src/Ai/Abilities.php:208
msgid "Publish immediately (otherwise saved as a draft)."
msgstr "Publier immédiatement (sinon enregistré comme brouillon)."

#: src/Ai/Abilities.php:260
msgid "Chart not found."
msgstr "Graphique introuvable."

#: src/Ai/Abilities.php:309
msgid "At least one bar with a label and a value is required."
msgstr "Au moins une barre avec un libellé et une valeur est requise."

