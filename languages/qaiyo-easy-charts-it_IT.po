#: src/Ai/Abilities.php:34
msgid "Qaiyo Easy Charts"
msgstr "Qaiyo Easy Charts"

#: src/Ai/Abilities.php:35
msgid "Create and read bar and column charts that can be embedded with a shortcode."
msgstr "Crea e leggi grafici a barre e a colonne incorporabili con uno shortcode."

#: src/Ai/Abilities.php:51
msgid "Label of the bar."
msgstr "Etichetta della barra."

#: src/Ai/Abilities.php:55
msgid "Where the solid bar ends."
msgstr "Dove termina la barra piena."

#: src/Ai/Abilities.php:59
msgid "Optional end of a highlighted range after the value, e.g. 15 for \"10–15\"."
msgstr "Fine facoltativa di un intervallo evidenziato dopo il valore, ad es. 15 per \"10–15\"."

#: src/Ai/Abilities.php:63
msgid "Optional text shown instead of the number, e.g. \"up to 5\"."
msgstr "Testo facoltativo mostrato al posto del numero, ad es. \"fino a 5\"."

#: src/Ai/Abilities.php:81
msgid "List charts"
msgstr "Elenca grafici"

#: src/Ai/Abilities.php:82
msgid "Lists the saved charts with their ID, title, status and the shortcode that embeds each one."
msgstr "Elenca i grafici salvati con ID, titolo, stato e lo shortcode per incorporarli."

#: src/Ai/Abilities.php:106
msgid "Get chart"
msgstr "Ottieni grafico"

#: src/Ai/Abilities.php:107
msgid "Returns one saved chart: its bars (label, value, optional range end and text), unit, orientation and shortcode."
msgstr "Restituisce un grafico salvato: barre (etichetta, valore, fine intervallo e testo facoltativi), unità, orientamento e shortcode."

#: src/Ai/Abilities.php:115
msgid "Chart ID."
msgstr "ID del grafico."

#: src/Ai/Abilities.php:152
msgid "Create chart"
msgstr "Crea grafico"

#: src/Ai/Abilities.php:153
msgid "Creates a saved bar or column chart and returns its ID and the shortcode to place it in content. Each bar has a label and a value; an optional range end draws a highlighted range (e.g. 10–15 days)."
msgstr "Crea un grafico a barre o a colonne salvato e restituisce il suo ID e lo shortcode per inserirlo nei contenuti. Ogni barra ha un’etichetta e un valore; una fine intervallo facoltativa disegna un intervallo evidenziato (ad es. 10–15 giorni)."

#: src/Ai/Abilities.php:161
msgid "Chart title; also its accessible name."
msgstr "Titolo del grafico; anche il suo nome accessibile."

#: src/Ai/Abilities.php:178
msgid "Unit shown on the axis, e.g. \"days\"."
msgstr "Unità mostrata sull’asse, ad es. \"giorni\"."

#: src/Ai/Abilities.php:182
msgid "Publish immediately (otherwise saved as a draft)."
msgstr "Pubblica subito (altrimenti salvato come bozza)."

#: src/Ai/Abilities.php:232
msgid "Chart not found."
msgstr "Grafico non trovato."

#: src/Ai/Abilities.php:277
msgid "At least one bar with a label and a value is required."
msgstr "È necessaria almeno una barra con etichetta e valore."

