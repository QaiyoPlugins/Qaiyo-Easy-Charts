{
	"name": "qaiyo/qaiyo-easy-charts",
	"description": "Simple, beautiful, animated and accessible charts for WordPress, Gutenberg, Elementor and Bricks Builder.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"homepage": "https://qaiyo-plugins.com/qaiyo-easy-charts/",
	"require": {
		"php": ">=8.0"
	},
	"require-dev": {
		"brain/monkey": "^2.6",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0",
		"phpcompatibility/phpcompatibility-wp": "^2.1",
		"phpstan/extension-installer": "^1.4",
		"phpstan/phpstan": "^2.1",
		"phpunit/phpunit": "^9.6",
		"szepeviktor/phpstan-wordpress": "^2.0",
		"wp-coding-standards/wpcs": "^3.1"
	},
	"autoload": {
		"psr-4": {
			"Qaiyo\\EasyCharts\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"Qaiyo\\EasyCharts\\Tests\\": "tests/"
		}
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true,
			"phpstan/extension-installer": true
		},
		"platform": {
			"php": "8.0.30"
		},
		"sort-packages": true
	},
	"scripts": {
		"lint": "phpcs",
		"lint:fix": "phpcbf",
		"analyse": "phpstan analyse --memory-limit=1G",
		"test": "phpunit",
		"i18n": "python3 languages/build-translations.py",
		"check": [
			"@lint",
			"@analyse",
			"@test",
			"@i18n"
		],
		"build": "bash bin/build-zip.sh"
	}
}
