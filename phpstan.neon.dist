parameters:
	level: max
	paths:
		- qaiyo-easy-charts.php
		- uninstall.php
		- src/
		- templates/
	scanFiles:
		- tests/stubs/elementor.php
		- tests/stubs/bricks.php
	bootstrapFiles:
		- tests/phpstan-bootstrap.php
	dynamicConstantNames:
		- QAIYO_EC_VERSION
		- QAIYO_EC_PLUGIN_DIR
		- QAIYO_EC_PLUGIN_URL
		- QAIYO_EC_BASENAME
		- QAIYO_EC_MIN_PHP
		- QAIYO_EC_MIN_WP
		- ELEMENTOR_VERSION
		- BRICKS_VERSION
